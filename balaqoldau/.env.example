# Public API address only. Never put passwords, DATABASE_URL or tokens in VITE_*.
VITE_API_BASE_URL=/api
# Admin transport must use a root-relative same-origin path; never put secrets here.
VITE_ADMIN_API_BASE_URL=/api/admin
# Vite dev server only; not exposed to the browser bundle.
API_PROXY_TARGET=http://127.0.0.1:3001
