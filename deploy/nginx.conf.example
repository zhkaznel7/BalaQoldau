# Template for inclusion inside nginx http {}, not an installed configuration.
# Replace domain/certificates/root. Validate with nginx -t in staging.
limit_req_zone $binary_remote_addr zone=balaqoldau_api:10m rate=100r/m;
server {
    listen 80;
    server_name support.example.com;
    access_log off;
    error_log /dev/null;
    return 308 https://support.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name support.example.com;
    ssl_certificate /etc/tls/balaqoldau/fullchain.pem;
    ssl_certificate_key /etc/tls/balaqoldau/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/balaqoldau/current/frontend/dist;
    index index.html;
    server_tokens off;
    access_log off;
    # Avoid request/PII-bearing ingress error logs. Configure PII-free metrics separately.
    error_log /dev/null;
    client_max_body_size 16k;
    client_body_timeout 15s;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # React uses inline styles for the photo clip path; inline scripts stay forbidden.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    location ~ /\. { deny all; }
    location ~* \.(map|ts|tsx|sql|log|key|pem|dump|backup)$ { return 404; }
    location /api/ {
        limit_req zone=balaqoldau_api burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host support.example.com;
        proxy_set_header X-Forwarded-Host support.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        proxy_send_timeout 20s;
        proxy_next_upstream off;
    }
    location = /api { return 404; }
    location /assets/ { try_files $uri =404; expires 1y; }
    location /images/ { try_files $uri =404; expires 1d; }
    location = /index.html { expires -1; }
    location / { try_files $uri $uri/ /index.html; }
}
