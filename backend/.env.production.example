# EXAMPLE ONLY: inject real values with the hosting secret manager; never commit them.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
# Only for the documented same-host ingress; keep false for direct connections.
TRUST_PROXY_LOOPBACK=true
CORS_ALLOWED_ORIGINS=https://support.example.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
DB_SSL_MODE=verify-full
# No password here. Supply authentication through the secret manager or a protected
# Required: production startup probes PostgreSQL before opening the HTTP listener.
# server-side password file. Replace hostname/user/database with verified targets.
DATABASE_URL=postgresql://balaqoldau_runtime@db.example.com:5432/balaqoldau_production
# For a private CA, configure Node's NODE_EXTRA_CA_CERTS before startup.
# Do not configure TEST_DATABASE_URL on the public application server.
# Configure retention separately on an authorized operator/job, not the public runtime:
# RETENTION_DATABASE_URL=postgresql://YOUR_RETENTION_ROLE@db.example.com:5432/balaqoldau_production
# RETENTION_EXPECTED_DATABASE=balaqoldau_production
# RETENTION_DAYS=30
# RETENTION_BATCH_SIZE=100

# Enable only after migrations 002-005, restricted grants and HTTPS staging verification.
# Production startup rejects owner/superuser/overprivileged admin runtime credentials.
ADMIN_ENABLED=false
# ADMIN_ORIGIN=https://YOUR_ADMIN_HOST.example.com
ADMIN_SESSION_SECONDS=3600
# ADMIN_PROVISION_DATABASE is for the offline provisioning process only, not runtime.
# ADMIN_PROVISION_ROLE=editor
