NODE_ENV=development
HOST=127.0.0.1
PORT=3001
TRUST_PROXY_LOOPBACK=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Required for database API/commands and production startup.
# Development/test health-only mode can omit it; /api/ready then returns 503.
# Supply your own credentials outside Git.
# DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/balaqoldau
# TEST_DATABASE_URL=postgresql://YOUR_TEST_USER:YOUR_PASSWORD@127.0.0.1:5432/balaqoldau_test
DB_SSL_MODE=disable
# Optional dedicated retention operator configuration; never falls back to DATABASE_URL.
# RETENTION_DATABASE_URL=postgresql://YOUR_RETENTION_ROLE@127.0.0.1:5432/balaqoldau_dev
# RETENTION_EXPECTED_DATABASE=balaqoldau_dev
RETENTION_DAYS=30
RETENTION_BATCH_SIZE=100

# Admin auth is opt-in, same-origin only. Node >=24.7 provides native Argon2id.
ADMIN_ENABLED=false
# ADMIN_ORIGIN=http://localhost:5173
ADMIN_SESSION_SECONDS=3600

# User accounts are opt-in and completely independent of admin authentication.
USER_AUTH_ENABLED=false
# USER_ORIGIN=http://localhost:5173
USER_SESSION_SECONDS=3600
USER_RESET_SECONDS=1800
# Optional existing local sendmail-compatible MTA; configure BOTH or neither.
# Never put mail credentials here. Without delivery configuration, reset is unavailable.
# USER_MAIL_COMMAND=/usr/sbin/sendmail
# USER_MAIL_FROM=support@example.com
# Offline operator command only; explicitly confirm the target database.
# ADMIN_PROVISION_DATABASE=balaqoldau_dev
# Offline provisioning only; default editor. Explicit admin is needed for initial bootstrap.
# ADMIN_PROVISION_ROLE=editor
