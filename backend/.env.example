NODE_ENV=development
HOST=127.0.0.1
PORT=3001
TRUST_PROXY_LOOPBACK=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Required for database API and commands; health-only mode can omit it.
# Supply your own credentials outside Git.
# DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/balaqoldau
# TEST_DATABASE_URL=postgresql://YOUR_TEST_USER:YOUR_PASSWORD@127.0.0.1:5432/balaqoldau_test
DB_SSL_MODE=disable
